# ── Agora project (Console > Project Management) ────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Agora RESTful API credentials (Console > Developer Toolkit > RESTful API)
# Different from App ID/Certificate above — used only for Basic auth on the
# Conversational AI Engine REST calls (join/leave agent).
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ── Public URL Agora's servers can reach to call OUR /llm/* endpoint ────────
# During the hackathon this MUST be a public tunnel, e.g.:
#   ngrok http 8000
# then paste the https://xxxx.ngrok-free.app URL here (no trailing slash).
# localhost will NOT work — Agora's cloud cannot reach your laptop directly.
PUBLIC_BACKEND_URL=http://localhost:8000

# ── STT (Deepgram: https://console.deepgram.com) ────────────────────────────
DEEPGRAM_API_KEY=

# ── TTS: pluggable vendor, pick one with "cartesia" | "elevenlabs" ──────────
TTS_VENDOR=cartesia

# Cartesia (https://play.cartesia.ai/keys) — RECOMMENDED. Free tier gives 2
# concurrent real-time streams, which is exactly our two-agent case, plus
# sub-90ms latency. Pick two different voices from https://play.cartesia.ai/voices
# so the two interviewers sound distinct.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_TECHNICAL=
CARTESIA_VOICE_ID_MANAGER=

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys) — only switch to
# this if you're on a PAID plan. Its free tier is frequently blocked by
# Agora's abuse-detection for real-time streaming and will silently kill
# audio mid-demo. Voices: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_TECHNICAL=
ELEVENLABS_VOICE_ID_MANAGER=

# ── LLM (Groq free tier: https://console.groq.com/keys) ─────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Misc ──────────────────────────────────────────────────────────────────
# Force mock mode even if keys are present (useful for offline UI/dev work).
MOCK_MODE=false
CORS_ORIGINS=http://localhost:3000
